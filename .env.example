# Headless WordPress REST / GraphQL API Base Endpoint URL
# Replace with your actual WordPress domain (e.g. https://cms.sandiegohomeservices.com or http://localhost:8000)
NEXT_PUBLIC_WORDPRESS_API_URL=https://your-wordpress-domain.com

# Optional Authentication Key for secure submissions
WORDPRESS_AUTH_TOKEN=your_wp_jwt_or_application_password_here
